# Copy to .env (gitignored). Never put these values in config.yaml or commit them.

# WATI (WhatsApp). UNVERIFIED: tenant URL looks like https://live-mt-server.wati.io/<tenant-id>
WATI_API_URL=
WATI_ACCESS_TOKEN=
WATI_TEMPLATE_NAME=
# Comma-separated, country code + number, digits only, e.g. 919800000000,919811111111
WATI_RECIPIENTS=

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=
